        {
          "info": {
            "name": "Reorder Queue Templates",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.galileo.ai/annotation_queues/:queue_id/templates/reorder",
            "params": [
              {
                "name": "queue_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
