              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Galileo-API-Key",
              "value": "{{Galileo-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Delete a template from an annotation queue.\n\nValidates that:\n- Template exists\n- Template belongs to the specified queue\n- User has UPDATE permission on the queue\n\nAfter deletion, remaining templates are renumbered to maintain sequential positions."
        },
