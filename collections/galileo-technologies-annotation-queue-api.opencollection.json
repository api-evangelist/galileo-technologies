            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Galileo-API-Key",
              "value": "{{Galileo-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Update an existing template in an annotation queue.\n\nCan update:\n- Template name (must be unique within the queue)\n- Template criteria\n\nNote: Constraints and other fields cannot be updated."
        },
        {
          "info": {
            "name": "Delete Queue Template",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.galileo.ai/annotation_queues/:queue_id/templates/:template_id",
            "params": [
              {
                "name": "template_id",
                "value": "",
