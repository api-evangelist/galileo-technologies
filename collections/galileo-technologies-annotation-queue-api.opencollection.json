              "value": "{{Galileo-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Create template(s) in an annotation queue.\n\nSupports two scenarios:\n1. Create a single template: Provide 'template' field\n2. Copy all templates from source queue: Provide 'copy_from_queue_id' field"
        },
