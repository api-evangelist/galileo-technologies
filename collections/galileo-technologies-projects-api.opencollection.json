        {
          "info": {
            "name": "Get Projects V2",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.galileo.ai/v2/projects/paginated",
            "params": [
              {
                "name": "actions",
                "value": "",
                "type": "query",
                "description": "Actions to include in the 'permissions' field."
              },
              {
                "name": "include_logstreams",
                "value": "",
                "type": "query",
                "description": "When true, include log streams (id and name) for each project."
              },
              {
                "name": "metric_id",
                "value": "",
                "type": "query",
                "description": "Filters logstreams to those with this metric enabled. Affects both the log_streams list (when include_logstreams=true) and the num_logstreams count."
              },
              {
                "name": "starting_token",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ],
